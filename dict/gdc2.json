  "rules": [
    {
      "re": "^Table sorted by (.+) in ascending order\\.$",
      "to": "表格已按 $1 升序排序。"
    },
    {
      "re": "^Table sorted by (.+) in descending order\\.$",
      "to": "表格已按 $1 降序排序。"
    },
    {
      "re": "^Maintenance will be conducted on GDC's infrastructure today (.+) from (.+) to (.+) CT\\. During this time, intermittent connectivity loss to the GDC portal and API is expected\\. We apologize for any inconvenience\\.$",
      "to": "GDC 基础设施将于今日 $1 的 $2 至 $3（美国中部时间）进行维护。在此期间，GDC 门户与 API 预计会出现间歇性连接中断。由此带来的不便，我们深表歉意。"
    },
    {
      "re": "^([\\d,]+) properties$",
      "to": "$1 个属性"
    }
  ],
  "templates": []
