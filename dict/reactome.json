  "rules": [
    {
      "re": "^(.+?) \\((\\d[\\d,]*)\\)$",
      "to": "$1（$2）",
      "requireHit": true
    },
    {
      "re": "^Showing ([\\d,]+) results out of ([\\d,]+)$",
      "to": "共 $2 条结果，当前显示 $1 条"
    },
    {
      "re": "^Results \\((\\d+) results from a total of ([\\d,]+)\\)$",
      "to": "结果（显示 $1 条，共 $2 条）"
    },
    {
