  "rules": [
    {
      "re": "^Gene ID: ?(\\d+)$",
      "to": "基因 ID：$1"
    },
    {
      "re": "^Gene ID: ?(\\d+), updated on (.+)$",
      "to": "基因 ID：$1，更新于 $2"
    },
    {
      "re": "^See all (\\d+) citations in Pubmed$",
      "to": "查看 PubMed 中全部 $1 条引用"
    },
    {
      "re": "^See all \\(([\\d,]+)\\) citations in PubMed$",
      "to": "查看 PubMed 中全部（$1）条引用"
    },
    {
      "re": "^See all GeneRIFs \\(([\\d,]+)\\)$",
      "to": "查看全部 GeneRIF（$1）"
    },
    {
      "re": "^See all ([\\d,]+) GeneRIFs$",
      "to": "查看全部 $1 条 GeneRIF"
    },
    {
      "re": "^Showing (\\d+) of ([\\d,]+) \\(by status, accession number\\)$",
      "to": "显示 $1 条，共 $2 条（按状态、登录号）"
    },
    {
      "re": "^See also ([\\d,]+) discontinued or replaced items?\\.$",
      "to": "另见 $1 条已停用或替换的条目。"
    },
    {
      "re": "^(.+): activate to sort column ascending$",
      "to": "$1：升序排序",
      "requireHit": true
    },
    {
      "re": "^(.+): activate to sort column descending$",
      "to": "$1：降序排序",
      "requireHit": true
    },
    {
      "re": "^PubMed Id\\(s\\): (.+)$",
      "to": "PubMed 编号：$1"
    },
    {
      "re": "^PubMed ID (\\d+)$",
      "to": "PubMed 编号 $1"
    },
    {
      "re": "^Status: (REVIEWED|PROVISIONAL|VALIDATED|SUPPRESSED|WITHDRAWN)$",
      "to": "状态：$1",
      "requireHit": true
    },
    {
      "re": "^Chromosome (\\d+) - (NC_\\d+\\.\\d+)$",
      "to": "染色体 $1 - $2"
    },
    {
      "re": "^Chromosome (\\d+), (NC_\\d+\\.\\d+) \\((\\d+)\\.\\.(\\d+), complement\\)$",
      "to": "染色体 $1，$2（$3..$4，互补链）"
    },
    {
      "re": "^Chromosome (\\d+), (NC_\\d+\\.\\d+) \\((\\d+)\\.\\.(\\d+)\\)$",
      "to": "染色体 $1，$2（$3..$4）"
    },
    {
      "re": "^(NC_\\d+\\.\\d+) Chromosome (\\d+) Reference (.+) Primary Assembly$",
      "to": "$1 染色体 $2 参考 $3 主要组装"
    },
    {
      "re": "^(NC_\\d+\\.\\d+) Chromosome (\\d+) Alternate (.+)$",
      "to": "$1 染色体 $2 替代 $3"
    },
    {
      "re": "^Reference (.+) Primary Assembly$",
      "to": "参考 $1 主要组装"
    },
    {
      "re": "^RefSeqs of Annotated Genomes: (.+)$",
      "to": "注释基因组的 RefSeq：$1"
    },
    {
      "re": "^See Variation Viewer \\((.+)\\)$",
      "to": "查看变异查看器（$1）"
    },
    {
      "re": "^See (\\w+) in$",
      "to": "查看 $1 的相关资源"
    },
    {
      "re": "^(.+) \\(e-PCR\\)$",
      "to": "$1（电子 PCR）"
    },
    {
      "re": "^Also known as: (.+)$",
      "to": "又名：$1"
    },
    {
      "re": "^Source: (.+)$",
      "to": "来源：$1"
    },
    {
      "re": "^Items (\\d+) - (\\d+) of ([\\d,]+)$",
      "to": "第 $1–$2 项，共 $3 项"
    },
    {
      "re": "^Showing (\\d+) of ([\\d,]+) items$",
      "to": "显示 $1 项，共 $2 项"
    },
    {
      "re": "^([\\d,]+) items?$",
      "to": "$1 项"
    },
    {
      "re": "^Genes, MANE Project \\(release (.+)\\)$",
      "to": "基因，MANE 项目（版本 $1）"
    },
    {
      "re": "^See identical proteins and their annotated locations for (NP_\\d+\\.\\d+)$",
      "to": "查看 $1 的相同蛋白质及其注释位置"
    },
    {
      "re": "^Variation Viewer \\((GRCh[\\d.]+(?:p\\d+)?)\\)$",
      "to": "变异查看器（$1）"
    }
  ],
  "templates": []
}
