    {
      "re": "^Time of last observation: ([\\d.]+) months?$",
      "to": "末次观察时间：$1 个月"
    },
    {
      "re": "^([0-2]:[A-Z]+):\\s*([\\d,]+)\\s*\\(([\\d.]+)%\\)$",
