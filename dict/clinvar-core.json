  "rules": [
    {
      "re": "^Review status: (.+?) Click for help$",
      "to": "审核状态：$1，点击查看帮助",
      "requireHit": true
    },
    {
      "re": "^Review status: (.+)$",
      "to": "审核状态：$1",
      "requireHit": true
    },
    {
      "re": "^(Conditions|Submissions|Classifications) - (Germline|Somatic)$",
      "to": "$1（$2）",
      "requireHit": true
    },
    {
      "re": "^First in ClinVar: (.+)$",
      "to": "首次收录于 ClinVar：$1"
    },
    {
      "re": "^Record last updated (.+)$",
      "to": "记录最后更新于 $1"
    },
    {
      "re": "^Accession: (.+)$",
      "to": "登录号：$1"
    },
    {
      "re": "^(?:_x000D_ ?)?Criteria applied: (.+)$",
      "to": "应用标准：$1"
    },
    {
      "re": "^Observation:? ?(\\d+)$",
      "to": "观察记录 $1"
    },
    {
      "re": "^Text-mined citations for (.+)$",
      "to": "$1 的文献挖掘引文"
    },
    {
      "re": "^HGVS: (.+)$",
      "to": "HGVS：$1"
    },
    {
      "re": "^gene and c\\. or p\\.: (.+)$",
      "to": "基因及 c. 或 p.：$1"
    },
    {
      "re": "^c\\. or p\\.: (.+)$",
      "to": "c. 或 p.：$1"
    },
    {
      "re": "^c\\./p\\.: (.+)$",
      "to": "c./p.：$1"
    },
    {
      "re": "^[Pp]rotein change: (.+)$",
      "to": "蛋白改变：$1"
    },
    {
      "re": "^rs number: (.+)$",
      "to": "rs 编号：$1"
    },
    {
      "re": "^gnomAD format: (.+)$",
      "to": "gnomAD 格式：$1"
    },
    {
      "re": "^ClinVar Variation ID: (.+)$",
      "to": "ClinVar 变异 ID：$1"
    },
    {
      "re": "^ClinVar accession number: (.+)$",
      "to": "ClinVar 登录号：$1"
    },
    {
      "re": "^Gene symbol: (.+)$",
      "to": "基因符号：$1"
    },
    {
      "re": "^GeneID: (.+)$",
      "to": "GeneID：$1"
    },
    {
      "re": "^UCSC: (.+)$",
      "to": "UCSC：$1"
    },
    {
      "re": "^gnomAD: (.+)$",
      "to": "gnomAD：$1"
    },
    {
      "re": "^Entrez: (.+)$",
      "to": "Entrez：$1"
    },
    {
      "re": "^PubMed \\((\\d+)\\):?$",
      "to": "PubMed（$1）"
    },
    {
      "re": "^PubMed: (.+)$",
      "to": "PubMed：$1"
    },
    {
      "re": "^DOI: (.+)$",
      "to": "DOI：$1"
    },
    {
      "re": "^pmc: (.+)$",
      "to": "PMC：$1"
    },
    {
      "re": "^\\.\\.\\. more (.+)$",
      "to": "…展开更多 $1"
    },
    {
      "re": "^\\.\\.\\. less (.+)$",
      "to": "…收起 $1"
    },
    {
      "re": "^\\+(\\d+) more$",
      "to": "另有 $1 条"
    },
    {
      "re": "^\\+ (\\d+) more$",
      "to": "另有 $1 条"
    },
    {
      "re": "^\\((more)\\)$",
      "to": "（更多）"
    },
    {
      "re": "^\\((less)\\)$",
      "to": "（收起）"
    },
    {
      "re": "^(\\d+) Single Heterozygotes?$",
      "to": "$1 例单一杂合子"
    },
    {
      "re": "^(\\d+)[-–](\\d+) years$",
      "to": "$1–$2 岁"
    },
    {
      "re": "^Variation ID: (.+)$",
      "to": "变异 ID：$1"
    },
    {
      "re": "^Study: (.+)$",
      "to": "研究：$1"
    },
    {
      "re": "^([\\d,]+) variants? for$",
      "to": "$1 条变异："
    }
  ],
