  "rules": [
    {
      "re": "^Entity ID: (\\d+)$",
      "to": "实体 ID：$1"
    },
    {
      "re": "^Latest Entries – As of (.+)$",
      "to": "最新条目 – 截至 $1"
    },
    {
      "re": "^(\\d+)% Identity$",
      "to": "$1% 一致性"
    },
    {
      "re": "^Slide (\\d+)$",
      "to": "第 $1 张"
    },
    {
      "re": "^Structure ([0-9A-Z]{4})$",
      "to": "结构 $1"
    },
    {
      "re": "^Validation slider image for (.+)$",
      "to": "$1 的验证滑块图"
    },
    {
      "re": "^Version (\\d+\\.\\d+): (\\d{4}-\\d{2}-\\d{2})$",
      "to": "版本 $1：$2"
    },
    {
      "re": "^Type: (.+)$",
      "to": "类型：$1"
    },
    {
      "re": "^Changes: (.+)$",
      "to": "变更：$1"
    },
    {
      "re": "^Query on (.+)$",
      "to": "查询 $1"
    },
    {
      "re": "^Focus chain (.+)$",
      "to": "聚焦链 $1"
    },
    {
      "re": "^(SDF|MOL2|mmCIF) format, chain (.+)$",
      "to": "$1 格式，链 $2"
    },
    {
      "re": "^Total Structure Weight: (.+)$",
      "to": "结构总重量：$1"
    },
    {
      "re": "^Atom Count: (.+)$",
      "to": "原子数：$1"
    },
    {
      "re": "^Modeled Residue Count: (.+)$",
      "to": "建模残基数：$1"
    },
    {
      "re": "^Deposited Residue Count: (.+)$",
      "to": "提交残基数：$1"
    },
    {
      "re": "^Unique protein chains: (.+)$",
      "to": "唯一蛋白质链数：$1"
    },
    {
      "re": "^Unique nucleic acid chains: (.+)$",
      "to": "唯一核酸链数：$1"
    },
    {
      "re": "^Resolution: (.+)$",
      "to": "分辨率：$1"
    },
    {
      "re": "^R-Value Work: (.+)$",
      "to": "R 值（工作）：$1"
    },
    {
      "re": "^R-Value Observed: (.+)$",
      "to": "R 值（观测）：$1"
    },
    {
      "re": "^Deposited: (.+)$",
      "to": "提交日期：$1"
    },
    {
      "re": "^Released Date: (.+)$",
      "to": "发布日期：$1"
    },
    {
      "re": "^(\\d+): Author Defined Assembly$",
      "to": "$1：作者定义的组装体"
    },
    {
      "re": "^This is version ([\\d.]+) of the entry\\. See complete history\\.$",
      "to": "本条目为第 $1 版，查看完整历史。"
    },
    {
      "re": "^(\\d+) Unique$",
      "to": "$1 个唯一配体"
    },
    {
      "re": "^Percentile relative to all X-ray structures$",
      "to": "相对于全部 X 射线结构的百分位"
    },
    {
      "re": "^Percentile relative to X-ray structures of similar resolution$",
      "to": "相对于相近分辨率 X 射线结构的百分位"
    },
    {
      "re": "^This is version ([\\d.]+) of the entry\\. See complete$",
      "to": "本条目为第 $1 版，查看完整"
    },
    {
      "re": "^([\\d.]+) \\(Depositor\\)$",
      "to": "$1（投稿人）"
    },
    {
      "re": "^Anisotropic B\\[(\\d)\\]\\[(\\d)\\]$",
      "to": "各向异性 B[$1][$2]"
    }
  ]
}
