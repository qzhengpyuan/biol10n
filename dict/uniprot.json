  "rules": [
    {
      "re": "^Isoform (\\d+)$",
      "to": "异构体 $1"
    },
    {
      "re": "^More (.+) links$",
      "to": "更多 $1 链接"
    },
    {
      "re": "^UniProt release (\\d{4}_\\d{2})$",
      "to": "UniProt 版本 $1"
    },
    {
      "re": "^UniProt release (\\d{4}_\\d{2}) released on \\w{3} (\\w{3}) (\\d{2}) (\\d{4})$",
      "to": "UniProt 版本 $1 发布于 $4 年 $2 $3 日"
    },
    {
      "re": "^(\\d+) publications?$",
      "to": "$1 篇文献"
    },
    {
      "re": "^Source:(.+)$",
      "to": "来源：$1"
    },
    {
      "re": "^Add (\\d+) entr(?:y|ies) to the basket$",
      "to": "将 $1 条条目加入购物篮"
    },
    {
      "re": "^Run an Align job against (\\d+) entr(?:y|ies)$",
      "to": "对 $1 条条目运行比对任务"
    },
    {
      "re": "^(\\d{1,2}) (\\w+) (\\d{4}) - (\\d{1,2}) (\\w+) (\\d{4})$",
      "to": "$3 年 $2 $1 日 - $6 年 $5 $4 日"
    },
    {
      "re": "^View protein in (.+)$",
      "to": "在 $1 中查看蛋白"
    },
    {
      "re": "^Community curated \\((\\d+)\\)$",
      "to": "社区注释（$1）"
    },
    {
      "re": "^Natural variants in (.+)$",
      "to": "$1 中的自然变异"
    },
    {
      "re": "^Download selected \\((\\d+)\\)$",
      "to": "已选下载（$1）"
    },
    {
      "re": "^Download all \\(([\\d,]+)\\)$",
      "to": "全部下载（$1）"
    },
    {
      "re": "^Preview (\\d+)$",
      "to": "预览前 $1 条"
    }
  ]
}
