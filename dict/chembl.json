  "rules": [
    {
      "re": "^Search results for (.+) - ChEMBL$",
      "to": "“$1”的检索结果 - ChEMBL"
    },
    {
      "re": "^Current Release: (.+)$",
      "to": "当前版本：$1"
    },
    {
      "re": "^Last Update on (.+) \\|$",
      "to": "最后更新：$1 |"
    },
    {
      "re": "^Search results for (.+)$",
      "to": "“$1”的检索结果"
    },
    {
      "re": "^Search for (.+)$",
      "to": "检索“$1”"
    },
    {
      "re": "^Showing ([\\d,]+)-([\\d,]+) out of ([\\d,]+) records$",
      "to": "显示第 $1–$2 条，共 $3 条记录"
    },
    {
      "re": "^(\\d+) - (\\d+) out of (\\d+)$",
      "to": "第 $1–$2 条，共 $3 条"
    },
    {
      "re": "^(\\d+)-(\\d+) of (\\d+)$",
      "to": "第 $1–$2 条，共 $3 条"
    },
    {
      "re": "^(\\d+) out of (\\d+)$",
      "to": "第 $1 条，共 $2 条"
    },
    {
      "re": "^Carousel slide (\\d+) of (\\d+)$",
      "to": "轮播图第 $1 张，共 $2 张"
    },
    {
      "re": "^Current Page, Page (\\d+)$",
      "to": "当前页，第 $1 页"
    },
    {
      "re": "^Goto Page (\\d+)$",
      "to": "转到第 $1 页"
    },
    {
      "re": "^(.+) \\(opens in a new tab\\)$",
      "to": "$1（在新标签页打开）",
      "requireHit": true
    },
    {
      "re": "^(.+): Not sorted\\. Activate to sort ascending\\.$",
      "to": "$1：未排序。激活后按升序排序。",
      "requireHit": true
    },
    {
      "re": "^(.+): Sorted ascending\\. Activate to remove sorting\\.$",
      "to": "$1：已按升序排序。激活后取消排序。",
      "requireHit": true
    },
    {
      "re": "^(.+): Sorted descending\\. Activate to remove sorting\\.$",
      "to": "$1：已按降序排序。激活后取消排序。",
      "requireHit": true
    },
    {
      "re": "^Structure of (.+)$",
      "to": "$1 的结构"
    },
    {
      "re": "^Interval Size \\((\\d+)\\)$",
      "to": "区间大小（$1）"
    },
    {
      "re": "^Items with no Year \\((\\d+)\\)$",
      "to": "无年份条目（$1 条）"
    },
    {
      "re": "^ChEMBL Synonyms \\((\\d+)\\):$",
      "to": "ChEMBL 同义词（$1）："
    },
    {
      "re": "^Synonyms from Alternative Forms \\((\\d+)\\):$",
      "to": "替代形式的同义词（$1）："
    },
    {
      "re": "^Trade Names \\((\\d+)\\):$",
      "to": "商品名（$1）："
    },
    {
      "re": "^All \\((\\d+) more\\)$",
      "to": "全部（另有 $1 条）"
    },
    {
      "re": "^Sources \\((\\d+)\\):$",
      "to": "数据来源（$1）："
    },
    {
      "re": "^Alternative forms of compound (.+)$",
      "to": "化合物 $1 的替代形式"
    },
    {
      "re": "^CHEMBL(\\d+) \\(Parent\\)$",
      "to": "CHEMBL$1（母体）"
    },
    {
      "re": "^Showing data from (.+) and its (\\d+) alternative forms?\\.$",
      "to": "显示 $1 及其 $2 个替代形式的数据。"
    },
    {
      "re": "^Compounds similar to (.+)$",
      "to": "与 $1 相似的化合物"
    },
    {
      "re": "^Compounds with at least (\\d+)% similarity\\.$",
      "to": "相似度至少 $1% 的化合物。"
    },
    {
      "re": "^Documents related to (.+) \\((\\d+) items\\)$",
      "to": "与 $1 相关的文献（$2 条）"
    },
    {
      "re": "^(\\d+)\\. (.+)$",
      "to": "$1. $2",
      "requireHit": true
    },
    {
      "re": "^Error: \\.$",
      "to": "错误。"
    },
    {
      "re": "^Error: \\. Please try again\\.$",
      "to": "错误。请重试。"
    },
    {
      "re": "^Description:$",
      "to": "说明："
    },
    {
      "re": "^Activities$",
      "to": "活性记录数"
    },
    {
      "re": "^Bioactivities$",
      "to": "生物活性记录数"
    },
    {
      "re": "^Web Search$",
      "to": "网络检索"
    },
    {
      "re": "^Assays$",
      "to": "实验"
    },
    {
      "re": "^Documents$",
      "to": "文献"
    },
    {
      "re": "^Approved$",
      "to": "已批准"
    },
    {
      "re": "^UniChem Connectivity Layer Cross References for (.+)$",
      "to": "与 $1 的 UniChem 连通层交叉引用"
    },
    {
      "re": "^link$",
      "to": "连线"
    },
    {
      "re": "^Warnings$",
      "to": "警示"
    }
  ],
  "templates": [
    {
      "pat": "{{1}} to move around the visualization, and {{2}} to zoom in and out.",
      "zh": "{{1}}即可在可视化中移动，{{2}}即可放大或缩小。"
    },
    {
      "pat": "Click the {{1}} button to return to the initial view.",
      "zh": "点击{{1}}按钮可返回初始视图。"
    },
    {
      "pat": "Click on a {{1}} to view details about the compound.",
      "zh": "点击{{1}}可查看该化合物的详细信息。"
    },
    {
      "pat": "Click on a {{1}} to see details of the metabolism conversion between compounds.",
      "zh": "点击{{1}}可查看化合物之间代谢转化的详细信息。"
    }
  ]
}
