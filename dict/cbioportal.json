    },
    {
      "re": "^Columns \\((\\d+) / (\\d+)\\)$",
      "to": "列（$1 / $2）"
    },
    {
      "re": "^\\(page (\\d+) of (\\d+)\\)$",
      "to": "（第 $1 页，共 $2 页）"
    },
    {
      "re": "^Showing (\\d+)-(\\d+) of ([\\d,]+) Mutations$",
      "to": "显示第 $1-$2 条，共 $3 条突变"
    },
    {
      "re": "^(.+) and (\\d+) more$",
      "to": "$1 等 $2 项"
    },
    {
      "re": "^(.+) \\((Driver|VUS)\\)$",
      "to": "$1（$2）",
      "requireHit": true
    },
    {
      "re": "^\\((.+)\\)$",
      "to": "（$1）",
      "requireHit": true
    },
    {
      "re": "^(.+): (.+)$",
      "to": "$1：$2",
      "requireHit": true
    }
  ]
