  "rules": [
    {
      "re": "^Category: (.+) \\((\\d+) Items?\\)$",
      "to": "类别：$1（$2 项）"
    },
    {
      "re": "^Category: (.+)$",
      "to": "类别：$1"
    },
    {
      "re": "^Track Settings: (.+)$",
      "to": "轨道设置：$1"
    },
    {
      "re": "^(.+) restriction endonuclease recognition and cleavage sites$",
      "to": "$1 限制性内切酶识别与切割位点"
    },
    {
      "re": "^(.+) Recognition Sites$",
      "to": "$1 识别位点"
    },
    {
      "re": "^Repeats identified by (.+)$",
      "to": "由 $1 识别的重复序列"
    }
  ],
  "templates": [
    {
      "pat": "{{1}} supports the exploration and analysis of {{2}} and selected non-NCBI annotated eukaryotic genome assemblies. Currently, assemblies from over 5190 organisms are available.",
      "zh": "{{1}} 支持对 {{2}} 以及选定的非 NCBI 注释真核基因组组装进行探索与分析。目前共有超过 5190 个物种的组装可用。"
    }
  ]
