  "rules": [
    {
      "re": "^(.+) - (\\d+) samples$",
      "to": "$1 - $2 个样本"
    },
    {
      "re": "^(.+) - (\\d+) patients$",
      "to": "$1 - $2 例患者"
    },
    {
      "re": "^(.+) - (\\d+) cases$",
      "to": "$1 - $2 例病例"
    },
    {
      "re": "^(.+) \\((\\d+)\\)$",
      "to": "$1（$2）",
      "requireHit": true
    },
    {
      "re": "^(.+) \\(TCGA, (.+)\\)$",
      "to": "$1（TCGA，$2）",
      "requireHit": true
    },
    {
      "re": "^num\\(T\\)=(\\d+); num\\(N\\)=(\\d+)$",
      "to": "肿瘤样本 $1 例；正常样本 $2 例"
    },
    {
      "re": "^TCGA, (.+)$",
      "to": "TCGA，$1",
      "requireHit": true
    },
    {
      "re": "^Stage (I{1,3}[ABC]?|IV[ABC]?)$",
      "to": "$1 期"
    },
    {
      "re": "^Grade ([1-4])$",
      "to": "$1 级"
    }
  ]
}
