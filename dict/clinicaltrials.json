  "rules": [
    {
      "re": "^Search ClinicalTrials\\.gov for: (.+) \\| Card Results \\| ClinicalTrials\\.gov$",
      "to": "检索 ClinicalTrials.gov：$1 | 卡片结果 | ClinicalTrials.gov"
    },
    {
      "re": "^My Saved Studies \\((\\d+)\\)$",
      "to": "我的已保存研究（$1）"
    },
    {
      "re": "^Revision: (v[\\d.]+)$",
      "to": "版本：$1"
    },
    {
      "re": "^All ([\\d,]+) studies$",
      "to": "全部 $1 项研究"
    },
    {
      "re": "^Viewing ([\\d,]+)-([\\d,]+) out of$",
      "to": "显示第 $1–$2 项，共"
    },
    {
      "re": "^Viewing ([\\d,]+)-([\\d,]+) out of ([\\d,]+) studies$",
      "to": "显示第 $1–$2 项，共 $3 项研究"
    },
    {
      "re": "^studies$",
      "to": "项研究"
    },
    {
      "re": "^Secondary$",
      "to": "次要"
    },
    {
      "re": "^(.*) \\| Superiority \\| (.*)$",
      "to": "$1 | 优效性 | $2"
    },
    {
      "re": "^(.*) \\| Non-Inferiority \\| (.*)$",
      "to": "$1 | 非劣效性 | $2"
    },
    {
      "re": "^(.*) \\| Equivalence \\| (.*)$",
      "to": "$1 | 等效性 | $2"
    },
    {
      "re": "^Show all ([\\d,]+) locations$",
      "to": "显示全部 $1 个地点"
    },
    {
      "re": "^This study has ([\\d,]+) locations$",
      "to": "本研究有 $1 个地点"
    },
    {
      "re": "^Clear Filters \\((\\d+)\\)$",
      "to": "清除筛选条件（$1）"
    },
    {
      "re": "^Clear \\((\\d+)\\)$",
      "to": "清除（$1）"
    },
    {
      "re": "^Select fields \\((\\d+)\\):$",
      "to": "选择字段（$1）："
    },
    {
      "re": "^Phase$",
      "to": "研究阶段"
    },
    {
      "re": "^Keywords Provided by (.+)$",
      "to": "关键词提供方：$1"
    },
    {
      "re": "^Statistical Analysis (\\d+)$",
      "to": "统计分析 $1"
    },
    {
      "re": "^Measure Type: (.+) \\| Unit of [Mm]easure: (.+)$",
      "to": "指标类型：$1 | 计量单位：$2"
    },
    {
      "re": "^Last updated on (.+)$",
      "to": "最后更新于 $1"
    },
    {
      "re": "^(Card|Table|Map|Topic) view is shown$",
      "to": "$1 视图已显示"
    },
    {
      "re": "^(Card|Table|Map|Topic) view is hidden$",
      "to": "$1 视图已隐藏"
    },
    {
      "re": "^Page (\\d+)$",
      "to": "第 $1 页"
    },
    {
      "re": "^Skip to Page (\\d+)$",
      "to": "跳到第 $1 页"
    },
    {
      "re": "^(.*) \\(opens in a new tab\\)$",
      "to": "$1（在新标签页打开）",
      "requireHit": true
    },
    {
      "re": "^\\| Time Frame:$",
      "to": "| 时间范围："
    },
    {
      "re": "^Publications$",
      "to": "论文"
    },
    {
      "re": "^Search for terms$",
      "to": "搜索词条"
    },
    {
      "re": "^Term from vocabulary, (.+)$",
      "to": "术语来自词表 $1"
    },
    {
      "re": "^(Median|Mean|Number) \\(([^)]+)\\) \\| Unit of [Mm]easure: (.+)$",
      "to": "$1（$2）| 计量单位：$3"
    },
    {
      "re": "^studies for: (.+)$",
      "to": "项研究，检索词：$1"
    },
    {
      "re": "^studies for:$",
      "to": "项研究"
    }
  ],
