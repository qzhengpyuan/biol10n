    },
    {
      "re": "^Samples \\(([\\d,]+)\\)$",
      "to": "样本（$1）"
    },
    {
      "re": "^Platforms \\(([\\d,]+)\\)$",
      "to": "平台（$1）"
    },
    {
      "re": "^DataSets \\(([\\d,]+)\\)$",
      "to": "数据集（$1）"
    },
    {
      "re": "^GEO Profiles \\(([\\d,]+)\\)$",
      "to": "GEO 表达谱（$1）"
