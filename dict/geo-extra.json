  "rules": [
    {
      "re": "^Platform (GPL\\d+)$",
      "to": "平台 $1"
    },
    {
      "re": "^Query DataSets for (GPL\\d+)$",
      "to": "查询 $1 的数据集"
    },
    {
      "re": "^Last modified: (.+)$",
      "to": "最后修改：$1"
    },
    {
      "re": "^(\\d+) ([A-Za-z0-9_\\-]+) \\(([^)]+)\\) runs?: ([\\d.,]+[KMG]?) spots?, ([\\d.,]+[KMG]?) bases, ([\\d.,]+[KMG]?b?) downloads$",
      "to": "$1 次 $2（$3）运行：$4 spot、$5 碱基、$6 下载"
    },
    {
      "re": "^The following term was not found in SRA: (.+)\\.$",
      "to": "在 SRA 中未找到以下检索词：$1。"
    },
    {
      "re": "^DataSet Record (G[A-Z]{2}[0-9]+):?$",
      "to": "数据集记录 $1："
    },
    {
      "re": "^(\\S+) Cluster Analysis$",
      "to": "$1 聚类分析"
    },
    {
      "re": "^(\\S+) Cluster Image$",
      "to": "$1 聚类图像"
    },
    {
      "re": "^([0-9]+)\\+ fold$",
      "to": "$1 倍以上"
    },
    {
      "re": "^Hierarchical$",
      "to": "层次聚类"
    },
    {
      "re": "^Complete$",
      "to": "完全连接"
    },
    {
      "re": "^Accession: (G[A-Z]{2}[0-9]+)$",
      "to": "登录号：$1"
    },
    {
      "re": "^Sample (GS[EMSD][0-9]+)$",
      "to": "样本 $1"
    }
  ]
}
