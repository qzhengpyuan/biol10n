  "rules": [
    {
      "re": "^Items: (\\d+) to (\\d+) of ([\\d,]+)$",
      "to": "第 $1 至 $2 项，共 $3 项"
    },
    {
      "re": "^(\\d+) per page$",
      "to": "每页 $1 条"
    },
    {
      "re": "^Page (\\d+) of ([\\d,]+)$",
      "to": "第 $1 页，共 $2 页"
    },
    {
      "re": "^of ([\\d,]+)$",
      "to": "共 $1 页"
    },
    {
      "re": "^Select item (\\d+)$",
      "to": "选择条目 $1"
    },
    {
      "re": "^Sort by (.+)$",
      "to": "按$1排序",
      "requireHit": true
    },
    {
      "re": "^(\\d+) selected items?: ([\\d,]+)$",
      "to": "已选 $1 项：$2"
    },
    {
      "re": "^Search: (.+)$",
      "to": "检索：$1"
    },
    {
      "re": "^Previous (\\d+)$",
      "to": "前 $1 条"
    },
    {
      "re": "^Next (\\d+)$",
      "to": "后 $1 条"
    }
  ],
