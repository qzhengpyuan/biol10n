  "rules": [
    {
      "re": "^See all results for '(.+)'$",
      "to": "查看“$1”的全部结果"
    },
    {
      "re": "^Phenotypes - (\\d+) of (\\d+) displayed$",
      "to": "表型：显示 $1 / $2"
    },
    {
      "re": "^Diseases - (\\d+) of (\\d+) displayed$",
      "to": "疾病：显示 $1 / $2"
    },
    {
      "re": "^\\[\\s*(\\d+)\\s+annotations?\\s*\\]$",
      "to": "[ $1 条注释 ]"
    },
    {
      "re": "^No medical actions found for (HP:\\d+)$",
      "to": "未找到 $1 的医学处置"
    },
    {
      "re": "^No LOINC associations found for (HP:\\d+)$",
      "to": "未找到 $1 的 LOINC 关联"
    },
    {
      "re": "^No disease associations found for$",
      "to": "未找到疾病关联"
    },
    {
      "re": "^Could not find requested entrez id (\\w+)\\.$",
      "to": "未找到所请求的 Entrez ID $1。"
    },
    {
      "re": "^(January|February|Feburary|March|April|May|June|July|August|September|October|November|December) (\\d{4})$",
      "to": "$2 年 $1"
    },
    {
      "re": "^(January|February|Feburary|March|April|May|June|July|August|September|October|November|December) (\\d{1,2}), (\\d{4})$",
      "to": "$3 年 $1 $2 日"
    }
  ],
  "templates": [
    {
      "pat": "That neither the content of the HPO file(s) nor the logical relationships embedded within the HPO file(s) be altered in any way. (Content additions and modifications have to be suggested using our {{1}}.)",
      "zh": "HPO 文件的内容及其内嵌的逻辑关系不得以任何方式更改。（内容的新增与修改须通过我们的 {{1}} 提出。）"
    },
    {
      "pat": "Please cite our {{1}} if you use the HPO for published work.",
      "zh": "如果你在已发表工作中使用 HPO，请引用我们的 {{1}}。"
    }
  ]
