  "rules": [
    {
      "re": "^» All references \\((\\d+)\\)$",
      "to": "» 全部参考文献（$1）"
    },
    {
      "re": "^Proteins \\((\\d+) molecules?\\)$",
      "to": "蛋白质（$1 个分子）"
    },
    {
      "re": "^Nucleotides\\((\\d+) molecules?\\)$",
      "to": "核苷酸（$1 个分子）"
    },
    {
      "re": "^Chemicals and Non-standard biopolymers \\((\\d+) molecules?\\)$",
      "to": "化学小分子与非标准生物聚合物（$1 个分子）"
    },
    {
      "re": "^(\\d+) Proteins$",
      "to": "$1 个蛋白质"
    },
    {
      "re": "^(\\d+) Nucleotide$",
      "to": "$1 个核苷酸"
    },
    {
      "re": "^Molecular Components in (.+)$",
      "to": "$1 的分子组成"
    },
    {
      "re": "^up to (\\d+)$",
      "to": "最多 $1 行"
    },
    {
      "re": "^All (\\d+) rows$",
      "to": "全部 $1 行"
    },
    {
      "re": "^([\\d,]+) rows$",
      "to": "$1 行"
    },
    {
      "re": "^([\\d.]+) bit$",
      "to": "$1 比特"
    },
    {
      "re": "^(\\d+) links$",
      "to": "$1 个链接"
    },
    {
      "re": "^(cd\\d+) Sequence Cluster$",
      "to": "$1 序列簇"
    },
    {
      "re": "^Items: ([\\d,]+)$",
      "to": "共 $1 项"
    },
    {
      "re": "^(\\d+) sequences?, including$",
      "to": "$1 条序列，包括"
    },
    {
      "re": "^is part of a hierarchy of related CD models\\.$",
      "to": "属于相关 CD 模型的层级体系。"
    },
    {
      "re": "^is a member of the superfamily$",
      "to": "属于超家族"
    }
  ],
