  "rules": [
    {
      "re": "^(.+) - The Human Protein Atlas$",
      "to": "$1 - 人类蛋白质图谱"
    },
    {
      "re": "^Version: ([\\d.]+)$",
      "to": "版本：$1"
    },
    {
      "re": "^Atlas updated: (.+)$",
      "to": "图集更新：$1"
    },
    {
      "re": "^Enriched genes: (\\d+)$",
      "to": "富集基因：$1"
    },
    {
      "re": "^Group enriched genes: (\\d+)$",
      "to": "组富集基因：$1"
    },
    {
      "re": "^Enhanced genes: (\\d+)$",
      "to": "增强基因：$1"
    },
    {
      "re": "^The new version (\\d+) of the Human Protein Atlas has been released$",
      "to": "人类蛋白质图谱第 $1 版已发布"
    },
    {
      "re": "^Proteome analysis based on (\\d+) antibodies targeting (\\d+) unique proteins$",
      "to": "基于 $1 种抗体、靶向 $2 个唯一蛋白质的蛋白质组分析"
    },
    {
      "re": "^(.+) antibodies$",
      "to": "$1 种抗体"
    }
  ]
