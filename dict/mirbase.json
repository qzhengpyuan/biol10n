 "rules": [
  {
   "re": "^Version ([\\d.]+) released (.+)$",
   "to": "版本 $1，发布于 $2"
  },
  {
   "re": "^Browse miRBase by species \\((\\d+) organisms\\)$",
   "to": "按物种浏览 miRBase（$1 个物种）"
  },
  {
   "re": "^miRBase entry: (.+)$",
   "to": "miRBase 条目：$1"
  },
  {
   "re": "^Stem-loop (.+)$",
   "to": "$1 的前体发夹结构"
  },
  {
   "re": "^Wordcloud for (.+)$",
   "to": "$1 词云"
  },
  {
   "re": "^(\\d+) open access papers mention (.+)$",
   "to": "有 $1 篇开放获取论文提及 $2"
  },
  {
   "re": "^([\\d.]+) reads per million, (\\d+) experiments$",
   "to": "每百万读数 $1，共 $2 个实验"
  },
  {
   "re": "^(.+) miRNAs$",
   "to": "$1 的 miRNA"
  },
  {
   "re": "^\\((\\d+) sentences\\)$",
   "to": "（$1 个句子）"
  },
  {
   "re": "^Showing (\\d+) to (\\d+) of ([\\d,]+) entries$",
   "to": "显示第 $1 至 $2 条，共 $3 条"
  },
  {
   "re": "^(.+): activate to sort column (ascending|descending)$",
   "to": "$1：点击按列$2排序"
  },
  {
   "re": "^mention (.+)$",
   "to": "提及 $1"
  },
  {
   "re": "^(\\d+) open access papers$",
   "to": "$1 篇开放获取论文"
  },
  {
   "re": "^reads per million, (\\d+) experiments$",
   "to": "每百万读数（RPM），$1 个实验"
  },
  {
   "re": "^Yes \\(\\+(\\d+)\\)$",
   "to": "是（+$1）"
  },
  {
   "re": "^No \\(-(\\d+)\\)$",
   "to": "否（-$1）"
  },
  {
   "re": "^(.+) is associated with one or more human diseases in the$",
   "to": "$1 与一种或多种人类疾病相关，见"
  },
  {
   "re": "^(.+) is involved in one or more biological pathways:$",
   "to": "$1 参与一条或多条生物学通路："
  },
  {
   "re": "^(.+) is involved in one or more regulation/signalling events:$",
   "to": "$1 参与一项或多项调控/信号事件："
  },
  {
   "re": "^(.+) precursor miRNA (.+)$",
   "to": "$1 前体 miRNA $2"
  },
  {
   "re": "^(.+) mature miRNA$",
   "to": "$1 成熟体 miRNA"
  },
  {
   "re": "^page for (.+)$",
   "to": "$1 的页面"
  }
 ]
}
