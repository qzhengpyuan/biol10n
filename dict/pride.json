  "rules": [
    {
      "re": "^Search PRIDE Archive · ([\\d,]+) datasets$",
      "to": "检索 PRIDE Archive · $1 个数据集"
    },
    {
      "re": "^List of Datasets \\((\\d+)\\)$",
      "to": "数据集列表（$1）"
    },
    {
      "re": "^Total ([\\d,]+) items$",
      "to": "共 $1 项"
    },
    {
      "re": "^Show more \\((\\d+)\\)$",
      "to": "显示更多（$1）"
    },
    {
      "re": "^(\\d+) /page$",
      "to": "$1 条/页"
    },
    {
      "re": "^View all ([\\d,]+) files$",
      "to": "查看全部 $1 个文件"
    },
    {
      "re": "^([\\d,]+) files · (.+)$",
      "to": "$1 个文件 · $2"
    },
    {
      "re": "^(\\d+) files$",
      "to": "$1 个文件"
    },
    {
      "re": "^(\\d+) shown$",
      "to": "已显示 $1 个"
    },
    {
      "re": "^([\\d,]+) samples/runs · (\\d+) columns$",
      "to": "$1 个样本/运行 · $2 列"
    },
    {
      "re": "^(\\d+) runs · (\\d+) metrics in (\\d+) columns$",
      "to": "$1 次运行 · $2 项指标，共 $3 列"
    },
    {
      "re": "^(\\d+) runs?$",
      "to": "$1 次运行"
    },
    {
      "re": "^precursor ([\\d.]+) ppm$",
      "to": "母离子 $1 ppm"
    },
    {
      "re": "^fragment ([\\d.]+) ppm$",
      "to": "碎片离子 $1 ppm"
    },
    {
      "re": "^datasets in ([A-Z][a-z]{2}) (\\d{4})$",
      "to": "$2 年 $1新增数据集"
    },
    {
      "re": "^Identification-free QC of ([\\d,]+) raw files from ([\\d,]+) datasets, computed by (.+) · updated (.+)$",
      "to": "由 $3 计算的免鉴定质控，覆盖 $1 个原始文件、$2 个数据集 · 更新于 $4"
    },
    {
      "re": "^If you cannot find an answer here, check the (.+) or write to (.+)\\.$",
      "to": "如果在这里找不到答案，请查看$1，或写信至$2。"
    },
    {
      "re": "^Datasets range from (.+) to (.+)$",
      "to": "数据集范围从 $1 到 $2"
    },
    {
      "re": "^Identification-free QC of ([\\d,]+) raw files from ([\\d,]+) datasets, computed by$",
      "to": "免鉴定质控（$1 个原始文件、$2 个数据集），计算工具："
    },
    {
      "re": "^· updated (.+)$",
      "to": "· 更新于 $1"
    },
    {
      "re": "^Percentile: (.+)$",
      "to": "百分位：$1"
    },
    {
      "re": "^Total Downloads: (.+)$",
      "to": "总下载次数：$1"
    },
    {
      "re": "^Group (\\d+)$",
      "to": "第 $1 组"
    },
    {
      "re": "^Files of (PXD\\d+)$",
      "to": "$1 的文件"
    }
  ],
  "templates": [
    {
      "pat": "This website requires cookies, and the limited processing of your personal data in order to function. By using the site you are agreeing to this as outlined in our {{1}} and {{2}}.",
      "zh": "本网站需要使用 Cookie 并对你的个人数据作有限处理才能正常运行。继续使用本站即表示你同意我们{{1}}与{{2}}中所述的内容。"
    },
    {
      "pat": "{{1}} This sample metadata was contributed by the proteomics community, not by the dataset submitter, and has not been verified by them. {{2}} · {{3}} · {{4}}",
      "zh": "{{1}} 该样本元数据由蛋白质组学社区贡献，并非由数据集提交者提供，也未经过其核实。{{2}} · {{3}} · {{4}}"
    }
  ]
}
