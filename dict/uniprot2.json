  "rules": [
    {
      "re": "^Chromosome ([0-9]{1,2}|X|Y|MT)$",
      "to": "$1 号染色体"
    },
    {
      "re": "^Computationally mapped \\(([\\d,]+)\\)$",
      "to": "计算映射（$1）"
    },
    {
      "re": "^Large scale \\(([\\d,]+)\\)$",
      "to": "大规模（$1）"
    },
    {
      "re": "^Small scale \\(([\\d,]+)\\)$",
      "to": "小规模（$1）"
    },
    {
      "re": "^Cited in ([\\d,+]+)$",
      "to": "被引用 $1 次"
    },
    {
      "re": "^Mapped to ([\\d,+]+)$",
      "to": "映射到 $1"
    },
    {
      "re": "^(\\d+) GO annotations? based on evolutionary models$",
      "to": "$1 条基于演化模型的 GO 注释"
    },
    {
      "re": "^(\\d+) NDEx IQuery Curated Pathways$",
      "to": "$1 条 NDEx IQuery 精选通路"
    },
    {
      "re": "^(\\d+) evidence items across (\\d+) molecular profiles$",
      "to": "$1 条证据，覆盖 $2 个分子谱"
    },
    {
      "re": "^(\\d+) hits in (\\d+) CRISPR screens$",
      "to": "$1 个命中，来自 $2 项 CRISPR 筛选"
    },
    {
      "re": "^(\\d+) antibodies from (\\d+) providers$",
      "to": "$1 个抗体，来自 $2 家供应商"
    },
    {
      "re": "^(\\d+) sequenced antibodies$",
      "to": "$1 个已测序抗体"
    },
    {
      "re": "^([\\d,]+) antibodies$",
      "to": "$1 个抗体"
    }
  ],
  "templates": []
}
