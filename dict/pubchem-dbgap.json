    },
    {
      "re": "^(.+) - Z to A$",
      "to": "$1（降序）"
    },
    {
      "re": "^(.+) - Oldest$",
      "to": "$1（最早优先）"
    },
    {
      "re": "^(.+) - Most Recent$",
      "to": "$1（最新优先）"
    },
    {
      "re": "^(.+) - Increasing$",
      "to": "$1（递增）"
    },
    {
      "re": "^(.+) - Decreasing$",
      "to": "$1（递减）"
    },
    {
      "re": "^Showing (\\d+) of ([\\d,]+)$",
      "to": "显示 $1 项，共 $2 项"
    },
    {
      "re": "^Showing ([\\d,]+)-([\\d,]+) of ([\\d,]+)$",
      "to": "显示第 $1–$2 项，共 $3 项"
