  "rules": [
    {
      "re": "^Current statistics \\((.+)\\)$",
      "to": "当前统计（$1）"
    },
    {
      "re": "^Last updated: (.+)$",
      "to": "最后更新：$1"
    },
    {
      "re": "^Copyright (\\d{4})-(\\d{4}) Kanehisa Laboratories$",
      "to": "版权所有 $1-$2 Kanehisa 实验室"
    },
    {
      "re": "^See Release notes \\((.+)\\)$",
      "to": "参见版本发布说明（$1）"
    },
    {
      "re": "^\\[ New (.+) \\| Update history \\]$",
      "to": "[ 新增$1 | 更新历史 ]"
    },
    {
      "re": "^Number of (.+) \\(([^()]+)\\)$",
      "to": "$1 数量（$2）"
    },
    {
      "re": "^(.+) statistics$",
      "to": "$1 统计"
    },
    {
      "re": "^(\\d+) organisms$",
      "to": "$1 个生物"
    },
    {
      "re": "^(.+) - KEGG pathway$",
      "to": "$1 - KEGG 通路"
    },
    {
      "re": "^(\\d+) entries$",
      "to": "$1 个条目"
    },
    {
      "re": "^(\\d+) pathways$",
      "to": "$1 条通路"
    }
  ]
}
