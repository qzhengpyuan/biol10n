  "rules": [
    {
      "re": "^Items: ([\\d,]+) to ([\\d,]+) of ([\\d,]+)$",
      "to": "第 $1 - $2 项，共 $3 项"
    },
    {
      "re": "^of ([\\d,]+)$",
      "to": "／ 共 $1 页"
    },
    {
      "re": "^Project data type: (.+)$",
      "to": "项目数据类型：$1"
    },
    {
      "re": "^Select item (.+)$",
      "to": "选择条目 $1"
    },
    {
      "re": "^Accession: (.+)$",
      "to": "登录号：$1"
    },
    {
      "re": "^ID: ([\\d,]+)$",
      "to": "编号：$1"
    },
    {
      "re": "^Publications \\(total ([\\d,]+)\\)$",
      "to": "论文（共 $1 篇）"
    },
    {
      "re": "^Download ([\\d,]+) Variant Regions$",
      "to": "下载 $1 个变异区域"
    },
    {
      "re": "^Download ([\\d,]+) Variant Calls$",
      "to": "下载 $1 个变异调用"
    },
    {
      "re": "^Remapped: (.+)$",
      "to": "重映射：$1"
    },
    {
      "re": "^Submitted: (.+)$",
      "to": "已提交：$1"
    },
    {
      "re": "^Open (.+) in Taxonomy Browser$",
      "to": "在分类学浏览器中打开 $1"
    },
    {
      "re": "^([\\d,]+) additional projects$",
      "to": "$1 个以上项目"
    },
    {
      "re": "^Number of Variants: ([\\d,]+)$",
      "to": "变异数：$1"
    },
    {
      "re": "^(\\d+) per page$",
      "to": "每页 $1 条"
    },
    {
      "re": "^Registration date: (.+)$",
      "to": "注册日期：$1"
    },
    {
      "re": "^\\[Taxonomy ID: ([\\d,]+)\\]$",
      "to": "［分类学 ID：$1］"
    },
    {
      "re": "^Number of Samplesets: ([\\d,]+)$",
      "to": "样本集数：$1"
    },
    {
      "re": "^Samples for sampleset ([\\d,]+)$",
      "to": "样本集 $1 的样本"
    }
  ],
  "templates": [
    {
      "pat": "Items {{1}} - {{2}} of {{3}}",
      "zh": "第 {{1}} - {{2}} 项，共 {{3}} 项"
    }
  ]
