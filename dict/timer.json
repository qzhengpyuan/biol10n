  "rules": [
    {
      "re": "^(.+) (TIMER|EPIC|CIBERSORT|CIBERSORT-ABS|quanTIseq|MCP-counter|xCell|ImmuCellAI|TIDE)$",
      "to": "$1 · $2"
    },
    {
      "re": "^CD8_T (.+)$",
      "to": "CD8+ T 细胞 · $1"
    },
    {
      "re": "^CD4_T (.+)$",
      "to": "CD4+ T 细胞 · $1"
    },
    {
      "re": "^B_T (.+)$",
      "to": "B 细胞 · $1"
    },
    {
      "re": "^T cell CD8\\+ (.+)$",
      "to": "CD8+ T 细胞 · $1"
    },
    {
      "re": "^T cell CD4\\+ (.+)$",
      "to": "CD4+ T 细胞 · $1"
    },
    {
      "re": "^Spearman's ρ ?: (positive|negative) correlation \\((.+)\\)$",
      "to": "Spearman's ρ：$1相关（$2）"
    },
    {
      "re": "^Spearman's ρ ?: no correlation \\((.+)\\)$",
      "to": "Spearman's ρ：无相关（$1）"
    }
  ]
}
