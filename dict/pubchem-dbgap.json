  "rules": [
    {
      "re": "^Computed by (.+)$",
      "to": "由 $1 计算"
    },
    {
      "re": "^PubChem release ([\\d.]+)$",
      "to": "PubChem 版本 $1"
    },
    {
      "re": "^release ([\\d.]+)$",
      "to": "版本 $1"
    },
    {
      "re": "^(\\d+) of ([\\d,]+)$",
      "to": "第 $1 页，共 $2 页"
    },
    {
      "re": "^Go to (.+) section$",
      "to": "转到 $1 部分"
    },
    {
      "re": "^MeSH Entry Terms for (.+)$",
      "to": "$1 的 MeSH 入口词"
    },
    {
      "re": "^([\\d,]+) vendors$",
      "to": "$1 个供应商"
    },
    {
      "re": "^([\\d,]+) items$",
      "to": "$1 个条目"
    },
    {
      "re": "^([\\d,]+) articles$",
      "to": "$1 篇文章"
    },
    {
      "re": "^([\\d,]+) patents from ([\\d,]+) patent families$",
