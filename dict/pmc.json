  "rules": [
    {
      "re": "^Figure (\\d+[A-Za-z]?)\\.$",
      "to": "图 $1."
    },
    {
      "re": "^Table (\\d+[A-Za-z]?)\\.$",
      "to": "表 $1."
    },
    {
      "re": "^PDF \\((.+)\\)$",
      "to": "PDF（$1）"
    },
    {
      "re": "^Articles from (.+) are provided here courtesy of$",
      "to": "以下文章由 $1 提供，承蒙以下机构惠允："
    },
    {
      "re": "^Edited by: (.+)$",
      "to": "编辑：$1"
    },
    {
      "re": "^Reviewed by: (.+)$",
      "to": "审稿：$1"
    },
    {
      "re": "^\\*Correspondence: (.+)$",
      "to": "通讯作者：$1"
    },
    {
      "re": "^Immediate release \\((\\d[\\d,]*)\\)$",
      "to": "立即开放（$1）"
    },
    {
      "re": "^Less than 12 months \\((\\d[\\d,]*)\\)$",
      "to": "少于 12 个月（$1）"
    },
    {
      "re": "^12 months \\((\\d[\\d,]*)\\)$",
      "to": "12 个月（$1）"
    },
    {
      "re": "^More than 12 months \\((\\d[\\d,]*)\\)$",
      "to": "超过 12 个月（$1）"
    },
    {
      "re": "^No longer published \\((\\d[\\d,]*)\\)$",
      "to": "已停止出版（$1）"
    },
    {
      "re": "^No longer participating \\((\\d[\\d,]*)\\)$",
      "to": "已不再参与（$1）"
    },
    {
      "re": "^All articles \\((\\d[\\d,]*)\\)$",
      "to": "全部文章（$1）"
    },
    {
      "re": "^NIH-funded articles \\((\\d[\\d,]*)\\)$",
      "to": "NIH 资助文章（$1）"
    },
    {
      "re": "^Journal added in last 30 days \\((\\d[\\d,]*)\\)$",
      "to": "近 30 天新增期刊（$1）"
    },
    {
      "re": "^Link to (.+)$",
      "to": "链接到 $1"
    }
  ]
