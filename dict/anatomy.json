  "rules": [
    {
      "re": "^(.+) enhanced and enriched$",
      "to": "$1 增强且富集"
    },
    {
      "re": "^(.+) enriched and enhanced$",
      "to": "$1 富集且增强"
    },
    {
      "re": "^(.+) enhanced$",
      "to": "$1 增强"
    },
    {
      "re": "^(.+) enriched$",
      "to": "$1 富集"
    },
    {
      "re": "^Enhanced in (.+)$",
      "to": "在 $1 中增强"
    },
    {
      "re": "^Enriched in (.+)$",
      "to": "在 $1 中富集"
    }
  ]
