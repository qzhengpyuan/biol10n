  "rules": [
    {
      "re": "^Showing (\\d+) to (\\d+) of ([\\d,]+) entries$",
      "to": "显示第 $1 至 $2 条，共 $3 条"
    },
    {
      "re": "^Data Source: GTEx Analysis Release (V\\d+) \\(dbGaP Accession (phs[\\d.]+)\\)$",
      "to": "数据来源：GTEx 分析版本 $1（dbGaP 登录号 $2）"
    },
    {
      "re": "^Data Source: Single cell snRNA-seq pilot$",
      "to": "数据来源：单细胞 snRNA-seq 试点"
    },
    {
      "re": "^(\\d+) of (\\d+) selected$",
      "to": "已选 $1/$2"
    },
    {
      "re": "^Bulk tissue gene expression for (.+)$",
      "to": "批量组织基因表达：$1"
    },
    {
      "re": "^Single tissue expression for (.+)$",
      "to": "单组织表达：$1"
    },
    {
      "re": "^Exon expression for (.+)$",
      "to": "外显子表达：$1"
    },
    {
      "re": "^Significant Single-Tissue (eQTLs|sQTLs|ieQTLs|isQTLs) for (.+) in all tissues$",
      "to": "所有组织中的显著单组织 $1：$2"
    },
    {
      "re": "^©(\\d{4}) Broad Institute of MIT and Harvard\\. All rights reserved\\.$",
      "to": "©$1 Broad Institute of MIT and Harvard 保留所有权利。"
    },
    {
      "re": "^(.+) \\[Source:HGNC Symbol;Acc:(HGNC:\\d+)\\]$",
      "to": "$1 [来源：HGNC 符号；登录号：$2]"
    },
    {
      "re": "^(.+): activate to sort column ascending$",
      "to": "$1：点击按列升序排序"
    },
    {
      "re": "^Exon Expression of (.+?):(.+)$",
      "to": "$1 的外显子表达：$2",
      "requireHit": false
    }
  ]
}
