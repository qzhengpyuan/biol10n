  "rules": [
    {
      "re": "^Gene Expression - CZ CELLxGENE Discover$",
      "to": "基因表达 - CZ CELLxGENE Discover"
    },
    {
      "re": "^Collections - CZ CELLxGENE Discover$",
      "to": "收藏集 - CZ CELLxGENE Discover"
    },
    {
      "re": "^Datasets - CZ CELLxGENE Discover$",
      "to": "数据集 - CZ CELLxGENE Discover"
    },
    {
      "re": "^CZ CELLxGENE Discover - Cellular Visualization Tool$",
      "to": "CZ CELLxGENE Discover - 细胞可视化工具"
    },
    {
      "re": "^([\\d,]+) of ([\\d,]+)$",
      "to": "$1 / $2 条"
    },
    {
      "re": "^([\\d,]+) consortia$",
      "to": "$1 个联盟"
    },
    {
      "re": "^Gene not found: (.+)$",
      "to": "未找到基因：$1"
    },
    {
      "re": "^(\\d[\\d,]*) 组织$",
      "to": "$1 个组织",
      "repair": true
    },
    {
      "re": "^(\\d[\\d,]*) 疾病$",
      "to": "$1 种疾病",
      "repair": true
    },
    {
      "re": "^(\\d[\\d,]*) 检测方法$",
      "to": "$1 种检测方法",
      "repair": true
    },
    {
      "re": "^(\\d[\\d,]*) 论文$",
      "to": "$1 篇发表文献",
      "repair": true
    },
    {
      "re": "^(\\d[\\d,]*) 联盟$",
      "to": "$1 个联盟",
      "repair": true
    },
    {
      "re": "^(\\d[\\d,]*) 发表文献$",
      "to": "$1 篇发表文献",
      "repair": true
    },
    {
      "re": "^CellGuide Cell Types and Cell Tissues - CZ CELLxGENE$",
      "to": "细胞指南：细胞类型与组织 - CZ CELLxGENE"
    }
  ],
  "templates": [
    {
      "pat": "Behind-the-scenes of {{1}} CELLxGENE",
      "zh": "{{1}} CELLxGENE 的幕后"
    }
  ]
