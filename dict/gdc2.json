{
  "meta": {
    "family": "gdc",
    "version": "0.1.0",
    "sites": [
      "portal.gdc.cancer.gov"
    ],
    "area": "portal/error-modal+table-a11y"
  },
  "exact": {
    "Unexpected Error": "意外错误",
    "An unexpected error has occurred. Your saved cohorts are being recovered, but your cart and sets may be lost.": "发生了意外错误。你保存的队列正在恢复，但数据车与集合可能会丢失。"
  },
  "rules": [
    {
      "re": "^Table sorted by (.+) in ascending order\\.$",
      "to": "表格已按 $1 升序排序。"
    },
    {
      "re": "^Table sorted by (.+) in descending order\\.$",
      "to": "表格已按 $1 降序排序。"
    }
  ],
  "templates": []
}
