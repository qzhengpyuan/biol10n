      "to": "第 $1 页，共 $2 页"
    },
    {
      "re": "^Search results for (.+)$",
      "to": "“$1”的检索结果"
    },
    {
      "re": "^Version (\\d{4})$",
      "to": "版本 $1"
    },
    {
      "re": "^Level (\\d+)$",
      "to": "第 $1 层"
    },
    {
      "re": "^Id: (.+)$",
      "to": "编号：$1"
    },
    {
      "re": "^Species: (.+)$",
      "to": "物种：$1"
    },
    {
