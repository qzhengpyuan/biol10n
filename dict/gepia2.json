  "rules": [
    {
      "re": "^(.+) - Copyright © (\\d+)$",
      "to": "$1 - 版权所有 © $2"
    },
    {
      "re": "^: (.+)$",
      "to": "：$1",
      "requireHit": true
    },
    {
      "re": "^(\\d+)% Confidence Interval$",
      "to": "$1% 置信区间"
    },
    {
      "re": "^Showing (\\d+) to (\\d+) of (\\d+) entries$",
      "to": "显示第 $1 至 $2 条，共 $3 条"
    },
    {
      "re": "^(.+): activate to sort column (ascending|descending)$",
      "to": "$1：点击按列$2排序"
    },
    {
      "re": "^Ensembl ID: (.+)$",
      "to": "Ensembl ID：$1",
      "requireHit": true
    },
    {
      "re": "^Description: (.+)$",
      "to": "描述：$1"
    },
    {
      "re": "^Alias: (.+)$",
      "to": "别名：$1"
    },
    {
      "re": "^Isoforms of (.+)$",
      "to": "$1 的异构体"
    }
  ]
}
