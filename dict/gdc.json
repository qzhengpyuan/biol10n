  "rules": [
    {
      "re": "^Data Release ([\\d.]+) - (\\w+) (\\d{1,2}), (\\d{4})$",
      "to": "数据发布 $1 - $4 年 $2 $3 日"
    },
    {
      "re": "^([\\d,]+) [Cc][Aa][Ss][Ee][Ss]$",
      "to": "$1 例病例"
    },
    {
      "re": "^(.+), ([\\d,]+) [Cc][Aa][Ss][Ee][Ss]$",
      "to": "$1，$2 例病例"
    },
    {
      "re": "^([\\d,]+) Disease Types$",
      "to": "$1 种疾病类型"
    },
    {
      "re": "^Select all (\\w+) rows on page (\\d+) of (\\d+)$",
      "to": "选中第 $2 页（共 $3 页）的全部$1行"
    },
    {
      "re": "^of$",
      "to": "条，共"
    },
    {
      "re": "^\\(n=$",
      "to": "（例数="
    },
    {
      "re": "^Open (.+) information in modal$",
      "to": "在弹窗中查看 $1 信息"
    },
    {
      "re": "^Select the (.+) project row$",
      "to": "选中 $1 项目行"
    },
    {
      "re": "^Sort (Projects|Mutations|Genes|Annotations) numerically$",
      "to": "按数值排序$1"
    },
    {
      "re": "^Save a new cohort of this case$",
      "to": "以此病例保存为新队列"
    },
    {
      "re": "^Save a new cohort of these ([\\d,]+) cases$",
      "to": "以这 $1 例病例保存为新队列"
    },
    {
      "re": "^(.+) Tool$",
      "to": "$1工具"
    },
    {
      "re": "^Toggle survival plot for (.+) gene$",
      "to": "切换 $1 基因的生存曲线"
    },
    {
      "re": "^Search the mutations table for (.+)$",
      "to": "在突变表中检索 $1"
    },
    {
      "re": "^Log-Rank Test P-Value = (.+)$",
      "to": "对数秩检验 P 值 = $1"
    },
    {
      "re": "^\\(N = ([\\d,]+)\\)$",
      "to": "（N = $1）"
    },
    {
      "re": "^Cases \\(n=([\\d,]+)\\)$",
      "to": "病例（例数=$1）"
    },
    {
      "re": "^Files \\(n=([\\d,]+)\\)$",
      "to": "文件（例数=$1）"
    },
    {
      "re": "^(.+) has been created\\. This is now your current cohort\\.$",
      "to": "已创建 $1，现已作为当前队列。"
    },
    {
      "re": "^The Next Generation Cancer Knowledge Base \\| NCI Genomic Data Commons$",
      "to": "下一代癌症知识库 | NCI 基因组数据共享平台"
    }
  ]
}
