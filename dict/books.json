  "rules": [
    {
      "re": "^Estimated reading time: (\\d+) minutes?$",
      "to": "预计阅读时间：$1 分钟"
    },
    {
      "re": "^Bookshelf ID: (\\S+)$",
      "to": "书架 ID：$1"
    },
    {
      "re": "^Figure (\\d+[A-Za-z]?)\\.$",
      "to": "图 $1."
    },
    {
      "re": "^Table (\\d+[A-Za-z]?)\\.$",
      "to": "表 $1."
    },
    {
      "re": "^Report \\(([\\d,]+)\\)$",
      "to": "报告（$1）"
    },
    {
      "re": "^Collection \\(([\\d,]+)\\)$",
      "to": "合集（$1）"
    },
    {
      "re": "^Results: ([\\d,]+) to ([\\d,]+) of ([\\d,]+) books? \\(([\\d,]+) items?\\)$",
      "to": "结果：第 $1 至 $2 项，共 $3 本图书（$4 条记录）"
    },
    {
      "re": "^Previous (\\d+)$",
      "to": "前 $1 个"
    },
    {
      "re": "^Next (\\d+)$",
      "to": "后 $1 个"
    },
    {
      "re": "^See more \\((\\d+)\\)\\.\\.\\.$",
      "to": "查看更多（$1）..."
    },
    {
      "re": "^FIGURE ([\\d.\\-]+)$",
      "to": "图 $1"
    },
    {
      "re": "^PDF \\((.+)\\)$",
      "to": "PDF 版（$1）"
    },
    {
      "re": "^Created: (.+); Last Update: (.+)$",
      "to": "创建于 $1；最后更新：$2"
    },
    {
      "re": "^Created: (.+)$",
      "to": "创建于 $1"
    },
    {
      "re": "^(\\d+)(?:st|nd|rd|th) edition$",
      "to": "第 $1 版"
    },
    {
      "re": "^Available from: (.+)$",
      "to": "可从以下地址获取：$1"
    },
    {
      "re": "^The NCBI Handbook - NCBI Bookshelf$",
      "to": "NCBI 手册 - NCBI 书架"
    },
    {
      "re": "^Bethesda \\(MD\\): National Center for Biotechnology Information \\(US\\); (.+)$",
      "to": "贝塞斯达（马里兰州）：美国国家生物技术信息中心（US）；$1"
    }
  ],
  "templates": [
    {
      "pat": "Bethesda (MD): {{1}}; {{2}}-.",
      "zh": "贝塞斯达（马里兰州）：{{1}}；{{2}}-."
    }
  ]
}
