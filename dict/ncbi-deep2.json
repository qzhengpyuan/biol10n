  "rules": [
    {
      "re": "^Gene ID: (\\d+), updated on (.+)$",
      "to": "基因 ID：$1，更新于 $2"
    },
    {
      "re": "^Gene type: (.+)$",
      "to": "基因类型：$1"
    },
    {
      "re": "^Go to complete Gene record for (.+)$",
      "to": "前往 $1 的完整基因记录"
    },
    {
      "re": "^Go to Variation Viewer for (.+) variants$",
      "to": "前往 $1 变异的变异查看器"
    },
    {
      "re": "^Variation Viewer for (.+) variants$",
      "to": "$1 变异的变异查看器"
    },
    {
      "re": "^Click to see all \\(([\\d,]+)\\) citations\\.$",
      "to": "点击查看全部 $1 条引用。"
    },
    {
      "re": "^No evidence available \\(Last evaluated (.+)\\)$",
      "to": "暂无证据（最后评估：$1）"
    },
    {
      "re": "^Sufficient evidence for dosage pathogenicity \\(Last evaluated (.+)\\)$",
      "to": "剂量致病性证据充分（最后评估：$1）"
    },
    {
      "re": "^OMIM®:$",
      "to": "OMIM®："
    },
    {
      "re": "^Release$",
      "to": "版本"
    },
    {
      "re": "^(Curated)$",
      "to": "人工整理"
    },
    {
      "re": "^Chromosome: ([0-9XYMT]+); (NC_\\d+\\.\\d+) \\((\\d+\\.\\.\\d+), complement\\)$",
      "to": "染色体：$1；$2（$3，互补链）"
    },
    {
      "re": "^Chromosome: ([0-9XYMT]+); (NC_\\d+\\.\\d+)$",
      "to": "染色体：$1；$2"
    },
    {
      "re": "^Chromosome: (.+)$",
      "to": "染色体：$1"
    }
  ],
  "templates": [
    {
      "pat": "From the {{1}} (EGAP)",
