  "rules": [
    {
      "re": "^Entity ID: (\\d+)$",
      "to": "实体 ID：$1"
    },
    {
      "re": "^Latest Entries – As of (.+)$",
      "to": "最新条目 – 截至 $1"
    },
    {
      "re": "^(\\d+)% Identity$",
      "to": "$1% 一致性"
    },
    {
      "re": "^Slide (\\d+)$",
      "to": "第 $1 张"
    },
    {
      "re": "^Structure ([0-9A-Z]{4})$",
      "to": "结构 $1"
    },
    {
      "re": "^Validation slider image for (.+)$",
      "to": "$1 的验证滑块图"
    },
    {
      "re": "^Version (\\d+\\.\\d+): (\\d{4}-\\d{2}-\\d{2})$",
      "to": "版本 $1：$2"
    },
    {
      "re": "^Type: (.+)$",
      "to": "类型：$1"
    },
    {
      "re": "^Changes: (.+)$",
      "to": "变更：$1"
    },
    {
      "re": "^Query on (.+)$",
      "to": "查询 $1"
    },
    {
      "re": "^Focus chain (.+)$",
      "to": "聚焦链 $1"
    },
    {
      "re": "^(SDF|MOL2|mmCIF) format, chain (.+)$",
      "to": "$1 格式，链 $2"
    },
    {
      "re": "^Total Structure Weight: (.+)$",
      "to": "结构总重量：$1"
    },
    {
      "re": "^Atom Count: (.+)$",
      "to": "原子数：$1"
    },
    {
      "re": "^Modeled Residue Count: (.+)$",
      "to": "建模残基数：$1"
    },
    {
      "re": "^Deposited Residue Count: (.+)$",
      "to": "提交残基数：$1"
    },
    {
      "re": "^Unique protein chains: (.+)$",
      "to": "唯一蛋白质链数：$1"
    },
    {
      "re": "^Unique nucleic acid chains: (.+)$",
