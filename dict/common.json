  "rules": [
    {
      "re": "^Error: (.+) is not found in (.+) Database$",
      "to": "错误：$1 未在 $2 数据库中找到"
    },
    {
      "re": "^((?:Mon|Tue|Tues|Wed|Thu|Thur|Thurs|Fri|Sat|Sun|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)),?\\s+(.+)$",
      "to": "$2（$1）",
      "requireHit": true
    },
    {
      "re": "^Showing (\\d+) of ([\\d,]+) results?$",
      "to": "显示第 $1 条，共 $2 条结果"
    },
    {
      "re": "^Showing ([\\d,]+)[-–](\\d+) of ([\\d,]+) results?$",
      "to": "显示第 $1–$2 条，共 $3 条结果"
    },
    {
      "re": "^Showing results (\\d+)[-–](\\d+) of ([\\d,]+)$",
      "to": "显示第 $1–$2 条结果，共 $3 条"
    },
    {
      "re": "^Results (\\d+)[-–](\\d+) of ([\\d,]+)$",
      "to": "结果第 $1–$2 条，共 $3 条"
    },
    {
      "re": "^([\\d,]+) results?$",
      "to": "共 $1 条结果"
    },
    {
      "re": "^Page (\\d+) of (\\d+)$",
      "to": "第 $1 页，共 $2 页"
    },
    {
      "re": "^Page (\\d+)$",
      "to": "第 $1 页"
    },
    {
      "re": "^Go to page (\\d+)$",
      "to": "转到第 $1 页"
    },
    {
      "re": "^Jump to page (\\d+)$",
      "to": "跳转到第 $1 页"
    },
    {
      "re": "^(\\d+) (?:items?|results?) per page$",
      "to": "每页 $1 条"
    },
    {
      "re": "^Displaying (\\d+) to (\\d+) of ([\\d,]+) items?$",
      "to": "显示第 $1 至 $2 项，共 $3 项"
    },
    {
      "re": "^Showing (\\d+) of ([\\d,]+)$",
      "to": "显示 $1 项，共 $2 项"
    },
    {
      "re": "^([\\d,]+) results? found$",
      "to": "找到 $1 条结果"
    },
    {
      "re": "^Results found: ([\\d,]+)$",
      "to": "找到结果：$1 条"
    },
    {
      "re": "^Search results for \"(.+)\"$",
      "to": "“$1”的检索结果"
    },
    {
      "re": "^No results found for \"(.+)\"$",
      "to": "未找到“$1”的结果"
    },
    {
      "re": "^Showing results for \"(.+)\"$",
      "to": "显示“$1”的检索结果"
    },
    {
      "re": "^Updated (\\d+) minutes? ago$",
      "to": "$1 分钟前更新"
    },
    {
      "re": "^Updated (\\d+) hours? ago$",
      "to": "$1 小时前更新"
    },
    {
      "re": "^Updated (\\d+) days? ago$",
      "to": "$1 天前更新"
    },
    {
      "re": "^Last updated: (.+)$",
      "to": "最后更新：$1"
    },
    {
      "re": "^Submitted on (.+)$",
      "to": "提交于 $1"
    },
    {
      "re": "^Version ([\\d.]+)$",
      "to": "版本 $1"
    },
    {
      "re": "^Sort by (.+)$",
      "to": "按 $1 排序"
    },
    {
      "re": "^Sorted by (.+)$",
      "to": "已按 $1 排序"
    },
    {
      "re": "^Filter by (.+)$",
      "to": "按 $1 筛选"
    },
    {
      "re": "^Filter results by (.+)$",
      "to": "按 $1 筛选结果"
    },
    {
      "re": "^(\\d+) (?:filters?|conditions?) applied$",
      "to": "已应用 $1 个筛选条件"
    },
    {
      "re": "^Clear all (\\d+) filters$",
      "to": "清除全部 $1 个筛选条件"
    },
    {
      "re": "^(\\d+) selected$",
      "to": "已选 $1 项"
    },
    {
      "re": "^(\\d+) of ([\\d,]+) (?:items|records|entries)$",
      "to": "第 $1 项，共 $2 项"
    },
    {
      "re": "^Result (\\d+) of (\\d+)$",
      "to": "第 $1 条结果，共 $2 条"
    },
    {
      "re": "^(.+) is required$",
      "to": "$1 为必填项"
    },
    {
      "re": "^Download all ([\\d,]+) results$",
      "to": "下载全部 $1 条结果"
    },
    {
      "re": "^Export all ([\\d,]+) results$",
      "to": "导出全部 $1 条结果"
    },
    {
      "re": "^Load more \\((\\d+) remaining\\)$",
      "to": "加载更多（剩余 $1 条）"
    },
    {
      "re": "^(\\d+) (?:records?|entries?)$",
      "to": "共 $1 条记录"
    },
    {
      "re": "^(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|May)\\.?\\s+(\\d{1,2}),?\\s*(\\d{4})$",
      "to": "$3 年 $1 $2 日"
    },
    {
      "re": "^(\\d{1,2})\\s+(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|May)\\s+(\\d{4})$",
      "to": "$3 年 $2 $1 日"
    },
    {
      "re": "^(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|May)\\s+(\\d{4})$",
      "to": "$2 年 $1"
    },
    {
      "re": "^Updated\\s+(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|May)\\.?\\s+(\\d{1,2}),\\s*(\\d{4})$",
      "to": "更新于 $3 年 $1 $2 日"
    },
    {
      "re": "^(.+), ([\\d,]+) cases$",
      "to": "$1：$2 例"
    },
    {
      "re": "^(\\d[\\d,]*)\\s+per page$",
      "to": "每页 $1 条"
    },
    {
      "re": "^(\\d[\\d,]*)\\s+(.+)$",
      "to": "$1 $2",
      "requireHit": true
    },
    {
      "re": "^(.+?)\\s*\\((.+)\\)$",
      "to": "$1（$2）",
      "requireHit": true
    },
    {
      "re": "^Figure\\s*(\\d+)$",
      "to": "图 $1"
    },
    {
      "re": "^Table\\s*(\\d+)$",
      "to": "表 $1"
    },
    {
      "re": "^Error: (.+) is not found in the (.+) database$",
      "to": "错误：$2 数据库中找不到 $1"
    },
    {
      "re": "^Error: (.+) is not found in the (.+) Database$",
      "to": "错误：$2 数据库中找不到 $1"
    }
  ],
  "templates": [
    {
      "pat": "{{1}} {{2}} The {{3}} ensures that you are connecting to the official website and that any information you provide is encrypted and transmitted securely.",
      "zh": "{{1}}{{2}} {{3}} 可确保你连接的是官方网站，且你提供的信息会被加密并安全传输。"
